.venv
.DS_Store
.vscode/settings.json

# API credentials written by setup_env.py - never commit
.env

# Per-app credential/state files written by web apps - never commit
web_apps/*/config.json
web_apps/*/profiles.json
web_apps/*/settings.json

# ncos_downloader: generated catalog cache and downloaded firmware images
web_apps/ncos_downloader/catalog_cache.json
web_apps/ncos_downloader/downloads/

# modem_upgrades: local job tracking and generated upgrade reports
web_apps/modem_upgrades/jobs.json
web_apps/modem_upgrades/reports/

# revert_device_firewall: per-run logs (contain device config that was removed)
web_apps/revert_device_firewall/logs/

# Python caches
__pycache__/
*.pyc
